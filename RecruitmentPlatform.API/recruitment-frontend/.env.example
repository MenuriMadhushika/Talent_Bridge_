# Copy this file to .env and point it at your running API.
# This project's ports are fixed in Properties/launchSettings.json:
# https://localhost:56846 and http://localhost:56847.
# Use the HTTPS port here — Program.cs calls UseHttpsRedirection(), which
# 307-redirects plain HTTP requests before CORS headers are attached, so
# the browser blocks the redirect and every request fails with
# "Failed to fetch" if you point this at the HTTP port instead.
# Run `dotnet dev-certs https --trust` once so the browser accepts the
# local dev certificate.
VITE_API_BASE_URL=https://localhost:56846/api
